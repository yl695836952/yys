# 藏宝阁登录 Cookie（必须包含 SID，属敏感信息，不要提交）
# 取法：浏览器登录藏宝阁 → F12 → Network → 任选一个 cgi 请求 → 复制请求头里的 Cookie 整行
CBG_COOKIE=""

# 可选：本地服务端口
YYS_PORT=24980
# 可选：抓取并发与节流（默认 4 / 0.15s）
YYS_CONCURRENCY=4
YYS_INTERVAL=0.15

# 可选：PVP/PVE 判定阈值
# YYS_PANEL_PASS=28000
# YYS_PANEL_GRAD=30000
# YYS_SPEED_PASS=158
# YYS_SPEED_GRAD=160
# YYS_LUCKY_SPEED_PASS=155
# YYS_LUCKY_SPEED_GRAD=158
# YYS_PVP_PASS=3000
# YYS_PVP_GRAD=3600
